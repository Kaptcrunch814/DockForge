@page "/"

@using DockForge.Core.Helpers
@using DockForge.Core.Interfaces
@using DockForge.Core.Models
@inject IDockerService DockerService

<PageTitle>DockForge</PageTitle>

<div class="dockforge-page">
    <div class="dockforge-header">
        <div>
            <h1>⚙ DockForge</h1>
            <p>Your Homelab Command Center</p>
        </div>

        <button class="btn btn-primary"
                @onclick="() => LoadContainersAsync()"
                disabled="@isLoading">
            @(isLoading ? "Refreshing..." : "Refresh")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    <div class="dashboard-grid">
        <section class="dashboard-card">
            <div class="card-header-row">
                <div>
                    <h2>🐳 Containers</h2>
                    <p>@containers.Count container@(containers.Count == 1 ? "" : "s") found</p>
                </div>
            </div>

            @if (isLoading && containers.Count == 0)
            {
                <p class="muted-text">Loading containers...</p>
            }
            else if (containers.Count == 0)
            {
                <p class="muted-text">No containers found.</p>
            }
            else
            {
                <div class="container-list">
                    @foreach (var container in containers)
                    {
                        var isDockForge = container.Name.Equals("dockforge", StringComparison.OrdinalIgnoreCase);
                        var isRestarting = restartingContainerId == container.Id;

                        <div class="container-row">
                            <div class="container-main">
                                <div class="container-name-row">
                                    <strong>@container.Name</strong>

                                    <span class="status-pill @GetStatusPillClass(container.Status)">
                                        @container.Status
                                    </span>
                                </div>

                                <div class="container-image">
                                    @container.Image
                                </div>

                                <div class="container-meta">
                                    Uptime: @UptimeFormatter.GetUptimeText(container)
                                </div>

                                @if (isDockForge)
                                {
                                    <div class="container-note">
                                        Restart disabled for DockForge itself.
                                    </div>
                                }
                            </div>

                            <div class="container-actions">
                                <a class="btn btn-sm btn-outline-info"
                                   href="@($"/containers/{container.Id}")">
                                    Details
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-warning"
                                        disabled="@(isDockForge || isRestarting || isLoading)"
                                        @onclick="() => RestartContainerAsync(container)">
                                    @(isRestarting ? "Restarting..." : "Restart")
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-secondary"
                                        disabled="@(isLoadingLogs && logContainerId == container.Id)"
                                        @onclick="() => LoadContainerLogsAsync(container)">
                                    @(isLoadingLogs && logContainerId == container.Id ? "Loading..." : "Logs")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="dashboard-card">
            <div class="card-header-row">
                <div>
                    <h2>📜 Logs</h2>

                    @if (string.IsNullOrWhiteSpace(logContainerName))
                    {
                        <p>Select a container to view recent output.</p>
                    }
                    else
                    {
                        <p>@logContainerName</p>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(logContainerName))
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-light"
                            disabled="@isLoadingLogs"
                            @onclick="RefreshSelectedLogsAsync">
                        @(isLoadingLogs ? "Refreshing..." : "Refresh Logs")
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(logErrorMessage))
            {
                <div class="alert alert-danger">
                    @logErrorMessage
                </div>
            }
            else if (string.IsNullOrWhiteSpace(logContainerName))
            {
                <div class="empty-log-panel">
                    No logs selected.
                </div>
            }
            else if (isLoadingLogs)
            {
                <p class="muted-text">Loading logs...</p>
            }
            else
            {
                <pre class="log-panel">@containerLogs</pre>
            }
        </section>
    </div>
</div>

@code {
    private List<ContainerInfo> containers = [];
    private bool isLoading = true;
    private string? restartingContainerId;
    private string? errorMessage;
    private string? successMessage;

    private string? logContainerId;
    private string? logContainerName;
    private string? containerLogs;
    private string? logErrorMessage;
    private bool isLoadingLogs;

    protected override async Task OnInitializedAsync()
    {
        await LoadContainersAsync();
    }

    private async Task LoadContainersAsync(bool clearMessages = true)
    {
        isLoading = true;

        if (clearMessages)
        {
            errorMessage = null;
            successMessage = null;
        }

        try
        {
            containers = await DockerService.GetContainersAsync();
        }
        catch (Exception ex)
        {
            containers = [];
            errorMessage = $"Unable to load containers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RestartContainerAsync(ContainerInfo container)
    {
        errorMessage = null;
        successMessage = $"Restarting {container.Name}...";
        restartingContainerId = container.Id;

        try
        {
            await DockerService.RestartContainerAsync(container.Id);

            await LoadContainersAsync(clearMessages: false);

            successMessage = $"Restarted {container.Name}.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to restart {container.Name}: {ex.Message}";
            successMessage = null;
        }
        finally
        {
            restartingContainerId = null;
        }
    }

    private async Task LoadContainerLogsAsync(ContainerInfo container)
    {
        logContainerId = container.Id;
        logContainerName = container.Name;

        await LoadLogsAsync(container.Id);
    }

    private async Task RefreshSelectedLogsAsync()
    {
        if (string.IsNullOrWhiteSpace(logContainerId))
        {
            return;
        }

        await LoadLogsAsync(logContainerId);
    }

    private async Task LoadLogsAsync(string containerId)
    {
        isLoadingLogs = true;
        logErrorMessage = null;
        containerLogs = null;

        try
        {
            containerLogs = await DockerService.GetContainerLogsAsync(containerId);

            if (string.IsNullOrWhiteSpace(containerLogs))
            {
                containerLogs = "No logs returned.";
            }
        }
        catch (Exception ex)
        {
            logErrorMessage = $"Unable to load logs: {ex.Message}";
        }
        finally
        {
            isLoadingLogs = false;
        }
    }

    private static string GetStatusPillClass(string status)
    {
        return status.Equals("running", StringComparison.OrdinalIgnoreCase)
            ? "status-running"
            : "status-stopped";
    }
}