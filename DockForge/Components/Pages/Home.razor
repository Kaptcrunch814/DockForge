@page "/"
@rendermode InteractiveServer

@using DockForge.Core.Interfaces
@using DockForge.Core.Models
@inject IDockerService DockerService

<PageTitle>DockForge</PageTitle>

<h1>⚙ DockForge</h1>

<p class="lead">
    Welcome to your Homelab Command Center.
</p>

<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">🐳 Containers</h3>

                    <button class="btn btn-sm btn-primary"
                            @onclick="() => LoadContainersAsync()"
                            disabled="@isLoading">
                        @(isLoading ? "Refreshing..." : "Refresh")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success">
                        @successMessage
                    </div>
                }

                @if (isLoading && containers.Count == 0)
                {
                    <p>Loading containers...</p>
                }
                else if (containers.Count == 0)
                {
                    <p>No containers found.</p>
                }
                else
                {
                    <p class="text-muted">
                        @containers.Count container@(containers.Count == 1 ? "" : "s") found
                    </p>

                    <ul class="list-group">
                        @foreach (var container in containers)
                        {
                            var isDockForge = container.Name.Equals("dockforge", StringComparison.OrdinalIgnoreCase);
                            var isRestarting = restartingContainerId == container.Id;

                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@container.Name</strong>
                                        <br />
                                        <small>@container.Image</small>
                                    </div>

                                    <div class="d-flex gap-2 align-items-center">
                                        <span class="badge @GetStatusBadgeClass(container.Status)">
                                            @container.Status
                                        </span>

                                        <button class="btn btn-sm btn-warning"
                                                disabled="@(isDockForge || isRestarting || isLoading)"
                                                @onclick="() => RestartContainerAsync(container)">
                                            @(isRestarting ? "Restarting..." : "Restart")
                                        </button>
                                    </div>
                                </div>

                                @if (isDockForge)
                                {
                                    <small class="text-muted">
                                        Restart disabled for DockForge itself.
                                    </small>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h3>📊 Resources</h3>
                <p>CPU: --</p>
                <p>RAM: --</p>
                <p>GPU: --</p>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ContainerInfo> containers = [];
    private bool isLoading = true;
    private string? restartingContainerId;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadContainersAsync();
    }

    private async Task LoadContainersAsync(bool clearMessages = true)
    {
        isLoading = true;

        if (clearMessages)
        {
            errorMessage = null;
            successMessage = null;
        }

        try
        {
            containers = await DockerService.GetContainersAsync();
        }
        catch (Exception ex)
        {
            containers = [];
            errorMessage = $"Unable to load containers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RestartContainerAsync(ContainerInfo container)
    {
        errorMessage = null;
        successMessage = $"Restarting {container.Name}...";
        restartingContainerId = container.Id;

        try
        {
            await DockerService.RestartContainerAsync(container.Id);

            await LoadContainersAsync(clearMessages: false);

            successMessage = $"Restarted {container.Name}.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to restart {container.Name}: {ex.Message}";
            successMessage = null;
        }
        finally
        {
            restartingContainerId = null;
        }
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status.Equals("running", StringComparison.OrdinalIgnoreCase)
            ? "bg-success"
            : "bg-secondary";
    }
}