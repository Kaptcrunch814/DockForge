FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["DockForge/DockForge.csproj", "DockForge/"]
COPY ["DockForge.Core/DockForge.Core.csproj", "DockForge.Core/"]
COPY ["DockForge.Services/DockForge.Services.csproj", "DockForge.Services/"]

RUN dotnet restore "DockForge/DockForge.csproj"

COPY . .

RUN dotnet publish "DockForge/DockForge.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "DockForge.dll"]